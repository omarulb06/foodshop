{
  "name": "food-shop-inventory",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:release": "expo run:android --variant release",
    "android:prebuild": "expo prebuild --platform android",
    "android:apk": "node ./scripts/build-apk.mjs",
    "ios": "expo run:ios",
    "ios:prebuild": "expo prebuild --platform ios",
    "ios:ipa": "npx eas-cli@latest build --platform ios --profile production",
    "ios:simulator": "npx eas-cli@latest build --platform ios --profile simulator",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "react-native-gesture-handler"
        ]
      }
    }
  },
  "overrides": {
    "react-dom": "19.2.3"
  },
  "dependencies": {
    "expo": "~57.0.26",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.20",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "firebase": "^12.19.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  }
}
